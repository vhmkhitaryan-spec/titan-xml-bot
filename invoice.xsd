					</choice>
				-->
			</xs:complexType>


			<xs:element name="SignedData" type="tax:SignedData" />

			<xs:element name="ExportedData" type="tax:ExportedData" />
			<xs:element name="Data" type="tax:Data" />

</xs:schema>
